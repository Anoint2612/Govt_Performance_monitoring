{
  "name": "hq-system-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seed/adminSeed.js",
    "seed:sample": "node src/seed/sampleData.js",
    "token": "node -r dotenv/config -e \"import('jsonwebtoken').then(m=>console.log(m.default.sign({userId:process.env.TOKEN_USER_ID}, process.env.JWT_SECRET,{expiresIn:'12h'})))\" dotenv_config_path=.env"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
